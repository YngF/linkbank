# Copy to .env for local dev. In Docker, set these as environment variables.

# Where the SQLite file lives (dev default shown).
DATABASE_PATH=data/linkbank.db

# Public origin. REQUIRED in production (node build): SvelteKit uses it for
# correct URLs and CSRF/login to work. Set it to the exact URL users visit,
# e.g. https://links.example.com. (Not needed for `npm run dev`.)
ORIGIN=http://localhost:3000

# Registration policy: open (anyone can sign up) | invite | closed
REGISTRATION=closed

# Days a deleted item stays in Trash before it's automatically purged.
TRASH_RETENTION_DAYS=30

# Link-rot checker: how often (hours) the background sweep re-checks bookmarks.
# Set to 0 to disable the scheduler entirely (the manual "Check now" button in
# the Broken-links view still works). Timeout per link is in milliseconds.
LINK_CHECK_INTERVAL_HOURS=24
LINK_CHECK_TIMEOUT_MS=8000

# Favicon fetcher: relax TLS-certificate checking (self-signed HTTPS on LAN).
# Set to 1/true only if you bookmark internal https sites with self-signed or
# otherwise-untrusted certs and want their icons fetched. This is SCOPED to the
# favicon fetcher — no other request in the app skips cert validation. Leave
# unset/0 to keep full TLS verification everywhere.
FAVICON_ALLOW_INSECURE_TLS=0
# Required only when REGISTRATION=invite — the code new users must enter.
INVITE_CODE=

# Notes are encrypted at rest (AES-256-GCM) so a leaked database/backup can't
# expose passwords stored in them. Provide a 32-byte key here — generate with:
#     openssl rand -base64 32
# RECOMMENDED: set this in your environment (kept OUT of the data volume/backup)
# — that's what actually protects a leaked backup.
# If left blank, a key is generated on first run and stored at <data>/notes.key.
# That works out of the box but only protects a partial leak (DB without the key
# file). WARNING: lose the key and encrypted notes are unrecoverable — back it up.
NOTES_ENCRYPTION_KEY=

# --- Postgres (optional) ----------------------------------------------------
# Leave unset to use SQLite (DATABASE_PATH above). Set DATABASE_URL to switch
# the whole app to PostgreSQL — no code change, migrations run on boot.
# DATABASE_URL=postgres://user:pass@localhost:5432/linkbank
# Max pooled connections (Postgres only).
# DATABASE_POOL_MAX=10
